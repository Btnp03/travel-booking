DATABASE_URL="postgresql://travel_user:travel_pass@localhost:5432/travel_db"
PORT=3001

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET="change-this-secret-before-production"
FRONTEND_URL="http://localhost:3000"

# --- Apache Cassandra / DataStax Astra DB Analytics Configuration ---
# Option 1: Local / Standard Cassandra
CASSANDRA_CONTACT_POINTS="127.0.0.1"
CASSANDRA_LOCAL_DATA_CENTER="datacenter1"
CASSANDRA_KEYSPACE="travel_analytics"
CASSANDRA_USERNAME=""
CASSANDRA_PASSWORD=""

# Option 2: DataStax Astra DB Cloud
# (If using Astra DB, fill bundle path and token below)
# CASSANDRA_ASTRA_BUNDLE_PATH="./secure-connect-travel-analytics.zip"
# CASSANDRA_ASTRA_TOKEN="AstraCS:..."
